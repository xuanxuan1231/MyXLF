<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的数据提取规则。

  allowBackup="false" 只关闭云端备份；换机迁移（device-transfer）仍会复制
  应用数据。安全存储的密文与设备 Keystore 绑定，迁移到新设备后无法解密，
  因此在两个通道里都排除全部数据，避免把不可用的凭据带到新设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
